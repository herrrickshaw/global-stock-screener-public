# Copy this file to `.env` (which is gitignored) and fill in your real values.
#   cp .env.example .env      then edit .env in your editor
# The `.env` file is never committed — keep your real password only there.

# screener.in login (unlocks India company fundamentals — see SCREENER_ACCESS.md)
SCREENER_EMAIL=you@example.com
SCREENER_PASSWORD=your-screener-password

# optional: email sending for the daily mailer (see send_mailer.py)
# GMAIL_USER=you@gmail.com
# GMAIL_APP_PASSWORD=your-16-char-app-password
# MAIL_TO=you@gmail.com

# optional: US data-verification cross-check (see verify_data.py). Databento
# has NO India coverage -- confirmed against its real dataset list, not
# marketing copy -- so India verification uses NSE Bhavcopy (free, no key
# needed) instead; only the US half needs this.
# DATABENTO_API_KEY=db-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# optional: where bhavcopy_history.py/bhavcopy_store.py cache NSE/BSE EOD
# data. Defaults to ~/Downloads/data/bhavcopy_cache -- override to keep it
# out of Downloads if that tree is shared with anything that periodically
# wipes untracked files.
# BHAV_CACHE=/path/to/a/safe/local/cache/dir
